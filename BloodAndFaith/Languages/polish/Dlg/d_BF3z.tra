@6500 = ~Hmf! Chcesz mnie z powrotem wpakować do ziemi, co? A ja nie wrócę! Nie, dopóki nie będzie po mojemu! Tylko ibrandulicki pogrzeb wsadzi mnie tam z powrotem!~
@6501 = ~Jakie są twoje warunki?~
@6502 = ~Mogę cię po prostu zabić, wiesz? Wtedy znowu będziesz martwy.~
@6503 = ~Przekażę to grabarzowi.~
@6504 = ~Urządzili mi błędny pogrzeb! Odprawili ceremonię dla helmitów! A ja żadnym helmitą nie jestem! Jestem górnikiem, z krwi i kości, a Helm to nie bóg dla górników – Ibrandul jest! Nie zostanę w ziemi, dopóki nie dostanę porządnego pogrzebu, godnego górnika!~
@6505 = ~Ba, już jestem martwy! Jak mnie zabijesz, to i tak znowu wstanę. Będę to robił dopóki nie dostanę porządnego ibrandulickiego pogrzebu!~
@6506 = ~Dobrze. Będę tu.~
@6507 = ~Idź im powiedz, żeby urządzili mi porządny ibrandulicki pogrzeb!~
@6508 = ~Odprawi go na nowo? No to jazda, ruszamy.~