@9000 = ~Chcesz się nas pozbyć, co? Cóż, nigdzie się nie ruszymy, dopóki nie znajdziesz nam czegoś lepszego!~
@9001 = ~Dlaczego tu jesteście?~
@9002 = ~Czego chcecie?~
@9003 = ~Na północ stąd jest nora, w której mieszkał kiedyś wyznawca Malara. Moglibyście się tam przenieść.~
@9004 = ~Na północ stąd jest nora, w której mieszkał kiedyś wyznawca Malara. Rozsądniej będzie zamieszkać tam – z dala od natrętnych poszukiwaczy przygód.~
@9005 = ~Nie mam zamiaru cię przekonywać. Po prostu was zabiję.~
@9006 = ~Hm. Wrócę później.~
@9007 = ~Mieszkamy tu. To ładne miejsce.~
@9008 = ~Chcemy tylko żyć w spokoju. Szczęśliwi, zdrowi, najedzeni.~
@9009 = ~Jak chcesz. My i tak tu zostajemy – w końcu to teraz nasz dom.~
@9010 = ~Jak chcesz. My i tak tu zostajemy – w końcu to teraz nasz dom.~
@9011 = ~Hmm... własne miejsce? Bez przepędzania, bez rozdeptywania? Hm... Spróbujemy.~
@9012 = ~Chwila, chwila! Wyglądasz mi na silnego. Nie chcemy z tobą walczyć. Odejdziemy.~ ~Chwila, chwila! Wyglądasz mi na silną. Nie chcemy z tobą walczyć. Odejdziemy.~
@9013 = ~Z dala od cywilizacji? Nie, dzięki. W dziczy niewiele się dzieje. I mniej darmowego jedzenia.~
@9014 = ~Ba! Mamy przewagę liczebną! Szczury, do ataku!~