@13133 = ~Mam nadziejê, ¿e nie bêdzie ci przeszkadzaæ ma³e odejœcie od normy. Tym razem ¿adnych nieumar³ych, nekromantów ani kultystów. Jedna z mieszkanek ma problem ze szczurami i chcê, ¿ebyœ siê tym zaj¹³. Mieszka niedaleko gospody P³on¹cy Czarodziej. Jakieœ pytania?~ ~Mam nadziejê, ¿e nie bêdzie ci przeszkadzaæ ma³e odejœcie od normy. Tym razem ¿adnych nieumar³ych, nekromantów ani kultystów. Jedna z mieszkanek ma problem ze szczurami i chcê, ¿ebyœ siê tym zajê³a. Mieszka niedaleko gospody P³on¹cy Czarodziej. Jakieœ pytania?~
@13134 = ~Chcesz, ¿ebym zaj¹³ siê gromadk¹ szczurów?~ ~Chcesz, ¿ebym zajê³a siê gromadk¹ szczurów?~ [4star]
@13135 = ~Nigdy nie mówi³am, ¿e ka¿de zadanie, które ci dam, bêdzie ekscytuj¹ce i pe³ne chwa³y, prawda? Œwi¹tynia ma obowi¹zki wobec Beregostu i jego mieszkañców. W³aœcicielka domu poprosi³a najpierw P³omienn¹ Piêœæ, ale oczywiœcie odmówili. Nie b¹dŸ taki ponury – mo¿e jednak wydarzy siê coœ interesuj¹cego. Poza tym chyba ka¿dy poszukiwacz przygód zaczyna³ od problemu ze szczurami.~ ~Nigdy nie mówi³am, ¿e ka¿de zadanie, które ci dam, bêdzie ekscytuj¹ce i pe³ne chwa³y, prawda? Œwi¹tynia ma obowi¹zki wobec Beregostu i jego mieszkañców. W³aœcicielka domu poprosi³a najpierw P³omienn¹ Piêœæ, ale oczywiœcie odmówili. Nie b¹dŸ taka ponura – mo¿e jednak wydarzy siê coœ interesuj¹cego. Poza tym chyba ka¿da poszukiwaczka przygód zaczyna³a od problemu ze szczurami.~ [4glum]
@13136 = ~Dobrze.~ [4rgood]
@13137 = ~Wróæ, kiedy uporasz siê z sytuacj¹.~ [4rnoye]
@13138 = ~Likantrop? Tutaj? Na Pana Poranka... gdybym tylko mog³a, posz³abym tam z tob¹. Dam ci dobr¹ radê. Spróbuj unikn¹æ walki i przekonaæ szczuro³aka, ¿eby odszed³ po dobroci. Nie by³ dot¹d agresywny, wiêc jest szansa, ¿e siê na to zgodzi. WeŸ te¿ ten srebrny sztylet, na wszelki wypadek. Niestety mam tylko jeden. Powodzenia, <CHARNAME>.~ [4yikes]
@13139 = ~Wróæ, gdy uporasz siê z sytuacj¹. I powodzenia.~ [4noye2]
@13140 = ~Zabi³em szczuro³aka.~ ~Zabi³am szczuro³aka.~
@13141 = ~Ciekawi mnie... dlaczego go zabi³eœ? To musia³a byæ trudna walka.~ [4whyk]
@13142 = ~Likantropy s¹ z³e. Nie mog³em pozwoliæ mu ¿yæ.~ ~Likantropy s¹ z³e. Nie mog³am pozwoliæ mu ¿yæ.~
@13143 = ~Likantropy s¹ zbyt niebezpieczne, zw³aszcza blisko cywilizacji. Zostawienie go przy ¿yciu by³oby zbyt ryzykowne.~
@13144 = ~Chcia³em doœwiadczyæ wymagaj¹cej walki.~ ~Chcia³am doœwiadczyæ wymagaj¹cej walki.~
@13145 = ~Nie mog³em go przekonaæ. To by³a jedyna opcja.~ ~Nie mog³am go przekonaæ. To by³a jedyna opcja.~
@13146 = ~Twierdzisz, ¿e s¹ z³e z racji samego istnienia? To doœæ okrutna wizja. A co z likantropami Selune? Có¿... miejmy nadziejê, ¿e nikt nigdy nie uzna, ¿e ty jesteœ zbyt niebezpieczny, by ¿yæ. Ale nie mamy czasu, by siê nad tym rozwodziæ. Porozmawiaj ze mn¹, gdy bêdziesz chcia³ podj¹æ siê kolejnego zadania.~ ~Twierdzisz, ¿e s¹ z³e z racji samego istnienia? To doœæ okrutna wizja. A co z likantropami Selune? Có¿... miejmy nadziejê, ¿e nikt nigdy nie uzna, ¿e ty jesteœ zbyt niebezpieczna, by ¿yæ. Ale nie mamy czasu, by siê nad tym rozwodziæ. Porozmawiaj ze mn¹, gdy bêdziesz chcia³a podj¹æ siê kolejnego zadania.~ [4ouch]
@13147 = ~Zastanawiam siê... czy nadejdzie dzieñ, w którym to ty bêdziesz uwa¿any za tak potê¿nego i tak groŸnego, ¿e ktoœ uzna, ¿e ciebie nie mo¿na zostawiæ przy ¿yciu? Ale nie mamy czasu na rozwa¿ania. Porozmawiaj ze mn¹, gdy bêdziesz chcia³ coœ zrobiæ.~ ~Zastanawiam siê... czy nadejdzie dzieñ, w którym to ty bêdziesz uwa¿ana za tak potê¿n¹ i tak groŸn¹, ¿e ktoœ uzna, ¿e ciebie nie mo¿na zostawiæ przy ¿yciu? Ale nie mamy czasu na rozwa¿ania. Porozmawiaj ze mn¹, gdy bêdziesz chcia³a coœ zrobiæ.~  [4risk]
@13148 = ~Naprawdê? A co z tob¹? Chcia³byœ, aby ktoœ pomyœla³ o tobie w podobny sposób? Choæ... mo¿e nawet by ci to odpowiada³o. Ale nie mamy czasu na takie dywagacje. Porozmawiaj ze mn¹, gdy bêdziesz chcia³ czegoœ siê podj¹æ.~ ~Naprawdê? A co z tob¹? Chcia³abyœ, aby ktoœ pomyœla³ o tobie w podobny sposób? Choæ... mo¿e nawet by ci to odpowiada³o. Ale nie mamy czasu na takie dywagacje. Porozmawiaj ze mn¹, gdy bêdziesz chcia³a czegoœ siê podj¹æ.~ [4relish]
@13149 = ~To niedobrze, ale tak ju¿ bywa. Przykro mi, <CHARNAME>, naprawdê, ale nie mamy czasu, ¿eby o tym dyskutowaæ. Porozmawiaj ze mn¹, gdy bêdziesz chcia³ czegoœ siê podj¹æ.~ [4roops] ~To niedobrze, ale tak ju¿ bywa. Przykro mi, <CHARNAME>, naprawdê, ale nie mamy czasu, ¿eby o tym dyskutowaæ. Porozmawiaj ze mn¹, gdy bêdziesz chcia³a czegoœ siê podj¹æ.~ [4roops]
@13150 = ~Szczurami dowodzi³ szczuro³ak, ale przekona³em ich, by przenieœli siê do nor, które kiedyœ zajmowa³ malaryta.~ ~Szczurami dowodzi³ szczuro³ak, ale przekona³am ich, by przenieœli siê do nor, które kiedyœ zajmowa³ malaryta.~
@13151 = ~Jestem ciekawa... dlaczego oszczêdzi³eœ szczuro³aka?~ ~Jestem ciekawa... dlaczego oszczêdzi³aœ szczuro³aka?~ [4rwhya]
@13152 = ~Nie by³ agresywny. Nie zaatakujê kogoœ, kto nie chce walczyæ. To by³oby z³e i niehonorowe.~
@13153 = ~Nie robi³ niczego z³ego. Nie zas³ugiwa³ na œmieræ tylko dlatego, ¿e by³ szczuro³akiem.~
@13154 = ~Naprawdê, ale to naprawdê nie chcia³em walczyæ z likantropem.~ ~Naprawdê, ale to naprawdê nie chcia³am walczyæ z likantropem.~
@13155 = ~Niehonorowe? Tak, wszyscy powinniœmy kierowaæ siê jakimiœ zasadami. Albo przynajmniej powinniœmy je mieæ. Dobra decyzja, <CHARNAME>. Porozmawiaj ze mn¹, gdy bêdziesz chcia³ czegoœ siê podj¹æ.~ ~Niehonorowe? Tak, wszyscy powinniœmy kierowaæ siê jakimiœ zasadami. Albo przynajmniej powinniœmy je mieæ. Dobra decyzja, <CHARNAME>. Porozmawiaj ze mn¹, gdy bêdziesz chcia³a czegoœ siê podj¹æ.~ [4rdish]
@13156 = ~Czyli nie mo¿emy zmieniæ tego, kim jesteœmy, ale mo¿emy zmieniæ to, kim siê stajemy. O to ci chodzi? Mam nadziejê, ¿e masz racjê, <CHARNAME>. Naprawdê. I chcia³abym, ¿eby wiêcej ludzi myœla³o tak jak ty. Ale nie ma sensu siê nad tym rozwodziæ. Porozmawiaj ze mn¹, gdy bêdziesz chcia³ czegoœ siê podj¹æ.~ ~Czyli nie mo¿emy zmieniæ tego, kim jesteœmy, ale mo¿emy zmieniæ to, kim siê stajemy. O to ci chodzi? Mam nadziejê, ¿e masz racjê, <CHARNAME>. Naprawdê. I chcia³abym, ¿eby wiêcej ludzi myœla³o tak jak ty. Ale nie ma sensu siê nad tym rozwodziæ. Porozmawiaj ze mn¹, gdy bêdziesz chcia³a czegoœ siê podj¹æ.~ [4rwho]
@13157 = ~To tchórzliwe, ale czasem tchórzostwo ratuje ¿ycie. Porozmawiaj ze mn¹, gdy bêdziesz chcia³ czegoœ siê podj¹æ.~ ~To tchórzliwe, ale czasem tchórzostwo ratuje ¿ycie. Porozmawiaj ze mn¹, gdy bêdziesz chcia³a czegoœ siê podj¹æ.~ [4rcow]


