@13158 = ~Chêtnie porozmawia³abym d³u¿ej, ale... na trakcie miêdzy gospod¹ „Pod Pomocn¹ D³oni¹” a Beregostem znajduje siê agent Zhentarimów. Zabij go. Jakieœ pytania?~ [5zhst]
@13159 = ~Mam go po prostu zabiæ? Nie mam z nim wczeœniej porozmawiaæ?~
@13160 = ~Jak go rozpoznam?~ 
@13161 = ~Jedyny dobry Zhent to martwy Zhent. Owszem, zdarzaj¹ siê odstêpcy od regu³y, ale tym razem nie o takiego chodzi. Coœ jeszcze?~ [5dead]
@13162 = ~Droga miêdzy Beregostem a gospod¹ „Pod Pomocn¹ D³oni¹” jest prosta jak strza³a. G³upot¹ by³oby iœæ ni¹ otwarcie, ale równie g³upio by³oby zapuszczaæ siê zbyt daleko od traktu. A agenci Zhentarimów w terenie nie s³yn¹ z subtelnoœci. Nie powinno byæ go trudno znaleŸæ. Coœ jeszcze?~ [5where]
@13163 = ~Zabij agenta Zhentarimów, <CHARNAME>.~ [5kill]
@13164 = ~Witaj ponownie, <CHARNAME>. Jak tam twoje zadanie?~ [5done]
@13165 = ~Agent Zhentarim nie ¿yje, choæ najpierw zd¹¿y³ trochê pogadaæ.~
@13166 = ~Doprawdy?~ [5did]
@13167 = ~Nazwa³ mnie twoj¹ „najnowsz¹ zabawk¹”.~
@13168 = ~Nale¿ysz do Harfiarzy? Dlatego wys³a³aœ mnie na Zhenta?~
@13169 = ~Co ten Zhent w ogóle o tobie wie?~
@13170 = ~PrzejdŸmy dalej.~
@13171 = ~Tak powiedzia³? Nie jesteœ pierwsz¹ osob¹, któr¹ wys³a³am w teren. Podejrzewam te¿, ¿e nie bêdziesz ostatni¹ – nie dlatego, ¿e zak³adam twoj¹ œmieræ, rzecz jasna. Mam nadziejê, ¿e z czasem pójdziesz w³asn¹ drog¹. Coœ jeszcze?~ [5move]
@13172 = ~Co? Nie. Ja... niewa¿ne. Nie nale¿ê do ¿adnych Harfiarzy. Coœ jeszcze?~ [5harp]
@13173 = ~Nazwa³ mnie twoj¹ „najnowsz¹ zabawk¹”.~
@13174 = ~Poza tym, ¿e jestem lathanderytk¹, a oni nas nie cierpi¹ z zasady? I ¿e œcigam przestêpców, a oni w³aœnie nimi s¹? I to od dawna? By³oby dziwne, gdyby o mnie nie wiedzieli. Coœ jeszcze?~ [5know]
@13175 = ~Z przyjemnoœci¹. Zg³oœ siê do mnie, kiedy bêdziesz gotów na kolejne zadanie. A oto z³oto w ramach nagrody za twój wysi³ek.~ ~Z przyjemnoœci¹. Zg³oœ siê do mnie, kiedy bêdziesz gotowa na kolejne zadanie. A oto z³oto w ramach nagrody za twój wysi³ek.~  [5end]


