@13221 = ~Jesteœ pewna, ¿e nie nale¿ysz do Harfiarzy?~
@13222 = ~Nie jest ju¿ Zhentem. Uciek³ – jest renegatem. Czy to wyjaœnia sprawê? Coœ jeszcze?~ [rz_02]
@13223 = ~Bo jeœli nie trafi tutaj albo do ilmaterytów, to prêdzej czy póŸniej zginie. Lathander naucza o odkupieniu. Nawet dla Zhentarimów. Coœ jeszcze?~ [rz_03]
@13224 = ~Tak, jestem pewna. Przestañ o to pytaæ. Coœ jeszcze?~ [rz_04]
@13225 = ~OdnajdŸ renegata i sprowadŸ go tutaj.~ [rz_05]
@13226 = ~Odes³a³em renegata w tê stronê. Inni Zhentarimowie próbowali go zabiæ, ale ju¿ siê tym nie zajm¹... a przy okazji nazwali mnie twoim „psem bojowym”.~ ~Odes³a³am renegata w tê stronê. Inni Zhentarimowie próbowali go zabiæ, ale ju¿ siê tym nie zajm¹... a przy okazji nazwali mnie twoim „psem bojowym”.~
@13227 = ~Mm. W gruncie rzeczy... mo¿e nie s¹ daleko od prawdy, co? Tak czy inaczej, dobra robota, <CHARNAME>. Mam dla ciebie kolejne zadanie – tym razem chyba mniej dramatyczne. Odezwij siê, kiedy bêdziesz gotów.~ ~Mm. W gruncie rzeczy... mo¿e nie s¹ daleko od prawdy, co? Tak czy inaczej, dobra robota, <CHARNAME>. Mam dla ciebie kolejne zadanie – tym razem chyba mniej dramatyczne. Odezwij siê, kiedy bêdziesz gotowa.~  [rz_06]
@13228 = ~Naprawdê? Tak ciê nazwali? Dziwne. Nie jesteœ szczególnie brutalny... na pewno nie tak ¿¹dny krwi jak oni. W ka¿dym razie – dobra robota, <CHARNAME>. Mam dla ciebie kolejne zadanie, raczej spokojniejsze. Odezwij siê, kiedy bêdziesz gotów.~ ~Naprawdê? Tak ciê nazwali? Dziwne. Nie jesteœ szczególnie brutalna... na pewno nie tak ¿¹dna krwi jak oni. W ka¿dym razie – dobra robota, <CHARNAME>. Mam dla ciebie kolejne zadanie, raczej spokojniejsze. Odezwij siê, kiedy bêdziesz gotowa.~ [rz_07]
@13229 = ~Zabi³em renegata Zhentarimów.~ ~Zabi³am renegata Zhentarimów.~
@13230 = ~CO TAKIEGO?! Przecie¿ wyraŸnie powiedzia³am, ¿ebyœ tego nie robi³! Niewa¿ne, jakie masz wyt³umaczenie. Wynoœ siê st¹d!~ ~CO TAKIEGO?! Przecie¿ wyraŸnie powiedzia³am, ¿ebyœ tego nie robi³a! Niewa¿ne, jakie masz wyt³umaczenie. Wynoœ siê st¹d!~  [rz_08]
@13231 = ~Wynoœ siê, <CHARNAME>.~ [rz_09]


// =====================
