// =====================

@13176 = ~Dobrze, to mamy ju¿ za sob¹. Wysy³am ciê teraz po Lenovolê – doœæ znan¹ kanibalkê. To nizio³ka... choæ zjada nie tylko nizio³ki, wiêc nie myœl, ¿e ktokolwiek z was jest bezpieczny. Poluje na podró¿nych miêdzy Beregostem a Nashkel, a czasem widywano j¹ te¿ w okolicach Gullykin. Szuka³abym jej w Samotnych Szczytach. Uwa¿aj, ¿eby ciê nie zjad³a – okaleczonego albo zbezczeszczonego cia³a nie da siê wskrzesiæ. Jeœli po¿re ciebie albo któregoœ z twoich towarzyszy, nic siê ju¿ nie da zrobiæ. Poza zabiciem jej, oczywiœcie. Jakieœ pytania?~ [6start]
@13177 = ~Da siê najpierw z ni¹ porozmawiaæ?~
@13178 = ~Zale¿y, jak bardzo bêdzie g³odna. A tak ca³kiem serio – raczej w¹tpiê. Kanibalizm to jej wybór i nie s¹dzê, by da³a siê od tego odwieœæ. Coœ jeszcze?~ [6choi]
@13179 = ~Wykonaj zadanie.~ [6comp]
@13180 = ~Ach, wróci³eœ – i nadal ¿yjesz. Œwietnie. Odezwij siê, gdy bêdziesz gotów na kolejne zlecenie. A, i jeszcze – weŸ ten pierœcieñ. Pomo¿e ci uchroniæ siê przed tym, by ktoœ ciê w przysz³oœci upiek³.~ ~Ach, wróci³aœ – i nadal ¿yjesz. Œwietnie. Odezwij siê, gdy bêdziesz gotowa na kolejne zlecenie. A, i jeszcze – weŸ ten pierœcieñ. Pomo¿e ci uchroniæ siê przed tym, by ktoœ ciê w przysz³oœci upiek³.~ [can_0]


