@13184 = ~Nie mam pytañ. Zajmê siê tym.~
@13185 = ~Nie wiem. Wiedz¹ to tylko sami bandyci. Bêdziesz musia³ znaleŸæ jakiœ trop, a obawiam siê, ¿e tu ci nie pomogê. Coœ jeszcze?~ ~Nie wiem. Wiedz¹ to tylko sami bandyci. Bêdziesz musia³a znaleŸæ jakiœ trop, a obawiam siê, ¿e tu ci nie pomogê. Coœ jeszcze?~ [ban_01]
@13186 = ~Nie jestem pewna. W³aœnie dlatego chcê, ¿ebyœ to ustali³. Coœ jeszcze?~ ~Nie jestem pewna. W³aœnie dlatego chcê, ¿ebyœ to ustali³a. Coœ jeszcze?~ [ban_02]
@13187 = ~Z³odziej Cienia okaza³ siê renegatem. Przy³¹czy³ siê do bandytów, bo uzna³, ¿e tylko oni go przyjm¹ po tym, co zrobi³. Odes³a³em go tutaj.~ ~Z³odziej Cienia okaza³ siê renegatem. Przy³¹czy³ siê do bandytów, bo uzna³, ¿e tylko oni go przyjm¹ po tym, co zrobi³. Odes³a³am go tutaj.~
@13188 = ~Tak? Co wp³ynê³o na tê decyzjê?~ [ban_03]
@13189 = ~Mo¿e zas³u¿y³ na œmieræ za swoje czyny, ale to nie mnie o tym decydowaæ.~
@13190 = ~Wygl¹da³ na skruszonego, a ja uzna³em, ¿e nale¿y mu siê druga szansa.~ ~Wygl¹da³ na skruszonego, a ja uzna³am, ¿e nale¿y mu siê druga szansa.~
@13191 = ~Naprawdê nie chcia³o mi siê walczyæ ze Z³odziejem Cienia, skoro i tak mia³em na g³owie ca³¹ bandê bandytów.~ ~Naprawdê nie chcia³o mi siê walczyæ ze Z³odziejem Cienia, skoro i tak mia³am na g³owie ca³¹ bandê bandytów.~
@13192 = ~Czyli nie chcesz byæ sêdzi¹, ³aw¹ przysiêg³ych i katem w jednej osobie? Zazwyczaj myœlê podobnie. Tak czy inaczej, mam dla ciebie coœ nowego. Odezwij siê, kiedy bêdziesz gotów.~ ~Czyli nie chcesz byæ sêdzi¹, ³aw¹ przysiêg³ych i katem w jednej osobie? Zazwyczaj myœlê podobnie. Tak czy inaczej, mam dla ciebie coœ nowego. Odezwij siê, kiedy bêdziesz gotowa.~  [ban_04]
@13193 = ~Jesteœ chlub¹ swojej wiary, <CHARNAME>. Odezwij siê, kiedy bêdziesz gotów.~ ~Jesteœ chlub¹ swojej wiary, <CHARNAME>. Odezwij siê, kiedy bêdziesz gotowa.~ [ban_05]
@13194 = ~Och? Czy¿byœ zaczyna³ braæ ze mnie przyk³ad? Mo¿e jeszcze zrobiê z ciebie lathanderytê! ¯arty na bok – mam dla ciebie coœ jeszcze. Porozmawiaj ze mn¹ znowu, gdy bêdziesz gotów na kolejne zadanie.~ ~Och? Czy¿byœ zaczyna³a braæ ze mnie przyk³ad? Mo¿e jeszcze zrobiê z ciebie lathanderytkê! ¯arty na bok – mam dla ciebie coœ jeszcze. Porozmawiaj ze mn¹ znowu, gdy bêdziesz gotowa na kolejne zadanie.~ [ban_06]
@13195 = ~Praktyczne podejœcie. Tak czy inaczej, mam dla ciebie kolejne zadanie. Odezwij siê, kiedy bêdziesz gotów.~ ~Praktyczne podejœcie. Tak czy inaczej, mam dla ciebie kolejne zadanie. Odezwij siê, kiedy bêdziesz gotowa.~ [ban_07]
@13196 = ~Z³odziej Cienia okaza³ siê renegatem. Przy³¹czy³ siê do bandytów, bo uzna³, ¿e tylko oni go przyjm¹ po tym, co zrobi³. Zabi³em go.~ ~Z³odziej Cienia okaza³ siê renegatem. Przy³¹czy³ siê do bandytów, bo uzna³, ¿e tylko oni go przyjm¹ po tym, co zrobi³. Zabi³am go.~
@13197 = ~Zas³u¿y³ na œmieræ za to, co robi³ jako Z³odziej Cienia.~
@13198 = ~Móg³ k³amaæ z tym renegactwem. Nie chcia³em ryzykowaæ, ¿e Z³odzieje Cienia wmieszaj¹ siê w sprawê bandytów.~ ~Móg³ k³amaæ z tym renegactwem. Nie chcia³am ryzykowaæ, ¿e Z³odzieje Cienia wmieszaj¹ siê w sprawê bandytów.~
@13199 = ~Nigdy wczeœniej nie walczy³em ze Z³odziejem Cienia i by³em tego ciekaw.~ ~Nigdy wczeœniej nie walczy³am ze Z³odziejem Cienia i by³am tego ciekaw.~
@13200 = ~I nie dosta³ drugiej szansy? Ludzie potrafi¹ zmieniaæ siê w zaskakuj¹cy sposób. Skoro by³ renegatem... có¿, nigdy siê ju¿ nie dowiemy. Tak czy inaczej, mam dla ciebie kolejne zadanie. Odezwij siê, kiedy bêdziesz gotów.~ ~I nie dosta³ drugiej szansy? Ludzie potrafi¹ zmieniaæ siê w zaskakuj¹cy sposób. Skoro by³ renegatem... có¿, nigdy siê ju¿ nie dowiemy. Tak czy inaczej, mam dla ciebie kolejne zadanie. Odezwij siê, kiedy bêdziesz gotowa.~
@13201 = ~Och. Tak, jeœli k³ama³, móg³by w przysz³oœci narobiæ wszystkim wielu k³opotów. Ostatnia rzecz, jakiej potrzebujemy, to wpl¹tanie siê Z³odziei Cienia w... cokolwiek siê tutaj dzieje. Niezale¿nie od tego, mam dla ciebie coœ innego. Porozmawiaj ze mn¹ ponownie, gdy bêdziesz gotów.~ ~Och. Tak, jeœli k³ama³, móg³by w przysz³oœci narobiæ wszystkim wielu k³opotów. Ostatnia rzecz, jakiej potrzebujemy, to wpl¹tanie siê Z³odziei Cienia w... cokolwiek siê tutaj dzieje. Niezale¿nie od tego, mam dla ciebie coœ innego. Porozmawiaj ze mn¹ ponownie, gdy bêdziesz gotowa.~ [ban_09]
@13202 = ~Nie walczy³eœ jeszcze z wieloma rzeczami. Gdybym wys³a³a ciê na spotkanie ze smokiem, te¿ byœ go zabi³? W ka¿dym razie – mam dla ciebie kolejne zadanie. Mo¿e och³odzi nieco twoj¹ ¿¹dzê walki. Odezwij siê, kiedy bêdziesz gotów.~ ~Nie walczy³aœ jeszcze z wieloma rzeczami. Gdybym wys³a³a ciê na spotkanie ze smokiem, te¿ byœ go zabi³a? W ka¿dym razie – mam dla ciebie kolejne zadanie. Mo¿e och³odzi nieco twoj¹ ¿¹dzê walki. Odezwij siê, kiedy bêdziesz gotowa.~


