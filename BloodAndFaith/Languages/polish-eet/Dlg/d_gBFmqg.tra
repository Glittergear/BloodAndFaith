@13269 = ~G³êbokie Piwnice pod Sp³onion¹ Syren¹. Kryje siê tam Mordiyin, wysoko postawiony zabójca Zhentarimów. Musi zgin¹æ, <CHARNAME>. Jakieœ pytania?~ [fin_01]
@13270 = ~Dlaczego sama tego nie zrobisz?~
@13271 = ~Sk¹d o tym wiesz?~
@13272 = ~Czemu nie poprosiæ o pomoc P³omiennej Piêœci?~
@13273 = ~Czemu nie wezwaæ Harfiarzy?~
@13274 = ~To chyba nie jest jakaœ pu³apka, prawda?~
@13275 = ~Co mo¿esz mi powiedzieæ o Mordiyinie?~
@13276 = ~Nie mam pytañ. Zajmê siê tym.~
@13277 = ~Ja... nie ufam sobie w tej sprawie. Za du¿o miêdzy nami zasz³o. Coœ jeszcze?~ [fin_02]
@13278 = ~Pamiêtasz dokumenty, które sprowadzi³eœ mi od helmitów? Powód, dla którego przyby³am do Wrót Baldura, zamiast zostaæ w Beregoœcie? To by³y papiery Zhentarimów. Nie by³o trudno z³amaæ ich szyfr i tak dowiedzia³am siê o tym wszystkim. Coœ jeszcze?~ ~Pamiêtasz dokumenty, które sprowadzi³aœ mi od helmitów? Powód, dla którego przyby³am do Wrót Baldura, zamiast zostaæ w Beregoœcie? To by³y papiery Zhentarimów. Nie by³o trudno z³amaæ ich szyfr i tak dowiedzia³am siê o tym wszystkim. Coœ jeszcze?~  [fin_03]
@13279 = ~P³omiennej Piêœci? Mówimy o tej samej organizacji? Nie radz¹ sobie z bandytami – jak wiêc mieliby poradziæ sobie ze Zhentarimami? Nie dadz¹ sobie rady. To by³aby rzeŸ, zak³adaj¹c, ¿e w ogóle odwa¿yliby siê tam pójœæ. Coœ jeszcze?~ [fin_04]
@13280 = ~¯yczê powodzenia w szybkim odnalezieniu Harfiarzy. Nawet jeœli ich znajdziesz, zasypi¹ ciê pytaniami. Ty stracisz czas, oni strac¹ czas... dok³adnie tak, jak my teraz. Coœ jeszcze?~ [fin_05]
@13281 = ~Oczywiœcie, <CHARNAME>, spêdzi³am ca³y ten czas, buduj¹c twoj¹ pozycjê, tylko po to, by poprowadziæ ciê w pu³apkê jak baranka na rzeŸ. Nie, to nie jest pu³apka. Coœ jeszcze?~ [fin_06]
@13282 =  ~Byliœmy kiedyœ partnerami. Unika³am i zabija³am wielu innych zabójców z Twierdzy Zhentil i wygl¹da na to, ¿e w koñcu przys³ali Mordiyina. Zna mnie wystarczaj¹co dobrze i zak³adam, ¿e wiedz¹, ¿e robi³am siê trochê zbyt sentymentalna. Ja... nie wiem, czy dam radê siê z nim zmierzyæ, dlatego wysy³am ciebie. I b¹dŸ ostro¿ny, ca³kiem dobrze radzi sobie w walce, a do tego potrafi u¿ywaæ magii. Nie wiem dok³adnie, do czego jest teraz zdolny, nie œledzi³am go. Byæ mo¿e by³ to z mojej strony b³¹d. Coœ jeszcze?~ [fin_07]
@13283 = ~Powodzenia, <CHARNAME>.~ [fin_08]
@13284 = ~Zabij Mordiyina, <CHARNAME>. Szybko. Proszê.~ [fin_09]
@13285 = ~Och, <CHARNAME>! Wróci³eœ.~ ~Och, <CHARNAME>! Wróci³aœ.~ [fin_10]
@13286 = ~Tak, wróci³em. Mordiyin mia³ sporo do powiedzenia.~ ~Tak, wróci³am. Mordiyin mia³ sporo do powiedzenia.~
@13287 = ~Tak... przypuszczam, ¿e mia³. Dobrze, zas³ugujesz na moj¹ szczeroœæ. Kiedyœ by³am agentk¹ Zhentarimów. Egzekutork¹. Tropi³am naszych wrogów bez litoœci i bez wahania, a ka¿dego, kto im pomóg³, choæby tylko udzieli³ schronienia... zabija³am. Z zimn¹ krwi¹. Zdarza³o siê, ¿e mordowa³am niewinnych tylko dlatego, ¿e ukrywali renegatów. Wymordowa³am ca³¹ œwi¹tyniê wraz z wyznawcami Ilmatera – choæ nikt z nich nawet nie podniós³ na mnie rêki. Próbowa³am uciec przed swoj¹ przesz³oœci¹. Byæ kimœ lepszym. Lathander obiecuje nowy dzieñ, ale ja nie potrafiê wyrwaæ siê z cienia w³asnych grzechów. Zhentarimowie mawiaj¹: „raz Zhent, zawsze Zhent”. I zaczynam rozumieæ, ¿e mieli racjê. Próbowa³am odkupiæ winy, pomagaj¹c innym renegatom... ale kiedy mówiê, ¿e jedyny dobry Zhent to martwy Zhent – wierz mi, wiem, co mówiê. Dlatego mam dla ciebie ostatnie zadanie. Chcê, ¿ebyœ by³ œwiadkiem mojej œmierci.~ ~Tak... przypuszczam, ¿e mia³. Dobrze, zas³ugujesz na moj¹ szczeroœæ. Kiedyœ by³am agentk¹ Zhentarimów. Egzekutork¹. Tropi³am naszych wrogów bez litoœci i bez wahania, a ka¿dego, kto im pomóg³, choæby tylko udzieli³ schronienia... zabija³am. Z zimn¹ krwi¹. Zdarza³o siê, ¿e mordowa³am niewinnych tylko dlatego, ¿e ukrywali renegatów. Wymordowa³am ca³¹ œwi¹tyniê wraz z wyznawcami Ilmatera – choæ nikt z nich nawet nie podniós³ na mnie rêki. Próbowa³am uciec przed swoj¹ przesz³oœci¹. Byæ kimœ lepszym. Lathander obiecuje nowy dzieñ, ale ja nie potrafiê wyrwaæ siê z cienia w³asnych grzechów. Zhentarimowie mawiaj¹: „raz Zhent, zawsze Zhent”. I zaczynam rozumieæ, ¿e mieli racjê. Próbowa³am odkupiæ winy, pomagaj¹c innym renegatom... ale kiedy mówiê, ¿e jedyny dobry Zhent to martwy Zhent – wierz mi, wiem, co mówiê. Dlatego mam dla ciebie ostatnie zadanie. Chcê, ¿ebyœ by³a œwiadkiem mojej œmierci.~ [fin_11]
@13288 = ~Nie b¹dŸ niedorzeczna. Wiesz przecie¿, ¿e sam œwiêty nie jestem. Jeœli potêpisz siebie, potêpiasz i mnie.~ ~Nie b¹dŸ niedorzeczna. Wiesz przecie¿, ¿e sama œwiêta nie jestem. Jeœli potêpisz siebie, potêpiasz i mnie.~
