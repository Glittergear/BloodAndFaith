@11500 = ~Des pièces… il me faut des pièces.~
@11501 = ~Vous voulez de l'or ? J'en ai ici.~
@11502 = ~Que faudrait-il pour que vous partiez ?~
@11503 = ~J'ai votre collection de pièces.~
@11504 = ~Je retrouverai votre collection de pièces.~
@11505 = ~Des pièces… pas mes pièces… Il me faut des pièces…~
@11506 = ~Des pièces… mes pièces…~
@11507 = ~Des pièces… mes pièces ! Merci…~
